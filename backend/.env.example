# APDS backend configuration (copy to .env or set in your platform dashboard)

# Public client key — identifies the app, required on all /api/* calls.
# NOT a secret; real security comes from sessions and scoped API keys.
APP_KEY=apk_change_me

# Server-side only. Never expose to clients.
GITHUB_TOKEN=

# Git-backed catalog/storage repository
DATA_REPO=web12-app/dbs
DATA_BRANCH=main

# SQLite database (server-side only)
DB_PATH=./marketplace.db

# Uploads
MAX_UPLOAD_MB=200
UPLOAD_SESSION_TTL_MIN=60

# Sessions
SESSION_TTL_DAYS=30

# Catalog read cache (seconds)
CACHE_TTL=20
